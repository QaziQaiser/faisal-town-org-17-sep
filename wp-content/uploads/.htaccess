# BEGIN CompressX
# The directives (lines) between "BEGIN CompressX" and "END CompressX" are
# dynamically generated, and should only be modified via WordPress filters.
# Any changes to the directives between these markers will be overwritten.

# END CompressX
# BEGIN WP Compress Security
# The directives (lines) between "BEGIN WP Compress Security" and "END WP Compress Security" are
# dynamically generated, and should only be modified via WordPress filters.
# Any changes to the directives between these markers will be overwritten.
<Files ~ "\.(php|php3|php4|php5|php7|php8|phtml|phar)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>
# END WP Compress Security